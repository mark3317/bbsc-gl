+// R12 is the talk condition evaluator (dispatcher 0203AD60 saves RDI there).
+// Replaces the old global f52 byte edit: the host retains its existing answer,
+// while a guest gets a solo answer only for the audited lamps/headstones.
+void PS4_SYSV_ABI BbscLampTalkMultiplayerHook(u64, const GuestRegisterSnapshot* registers) {
+    if (!registers) return;
+    const u64 condition = registers->r12;
+    const u64 global = GetGlobalState();
+    const bool host = Core::Bbsc::SwitchEnabled("SHADPS4_BBSC_LAMP") &&
+                      GetSessionState() == 3 && GetLocalPlayerType() == 0 &&
+                      ReadablePointer(global, 0x1593) && ReadValue<u8>(global, 0x1592) != 0;
+    const bool guest = ReadablePointer(condition, 0x30) &&
+                       ReadValue<u64>(condition, 0) == image_base + 0x0535AAB0 &&
+                       BbscPersonalTravelTalk(ReadValue<u32>(condition, 0x10));
+    if (host || guest) {
+        auto* changed = const_cast<GuestRegisterSnapshot*>(registers);
+        changed->rax &= ~u64{0xFF};
+        changed->rcx &= ~u64{0xFF};
+    }
+}
+
+// Native load step 019297E0 normally replaces the destination with the old
+// summoned map at phase 3. For an explicitly personal trip select its normal
+// map/bonfire branch instead. Only the comparison reads this zero phase; the real
+// rules stay at 3 for session persistence and guest reconstruction.
+void PS4_SYSV_ABI BbscPersonalTravelLoadHook(u64, const GuestRegisterSnapshot* registers) {
+    if (registers && BbscPersonalTravelActive() && GetSessionState() == 6 &&
+        GetBbscRelayHost() == bbsc_personal_travel_host)
+        const_cast<GuestRegisterSnapshot*>(registers)->rax =
+            reinterpret_cast<u64>(bbsc_personal_travel_non_summon_phase.data());
+}
+
+// Called only for c1_11 from this game's local talk executor, before SetEventFlag.
+// Returning true consumes the request, so neither the host nor common.7200 sees it.
+bool QueueBbscPersonalTravel(u32 flag, u8 value) {
+    if (!value || !BbscPersonalTravelGuest()) return false;
+    const u32 here = GetCurrentPackedMap();
+    s32 point = 0;
+    if (here != 0x15000000 && flag >= 70000200 && flag < 70000210) {
+        // Each ground lamp's confirmed travel command uses 70000200 + its index.
+        point = 2102950;
+    } else if (here == 0x15000000) {
+        for (const auto& destination : LampTravel::Returns) {
+            if (destination.flag == flag) { point = destination.point; break; }
+        }
+    }
+    if (!point) return false;
+    // Consume even a rejected duplicate/unsafe request; never let it leak to vanilla.
+    const u64 global = GetGlobalState();
+    if (!bbsc_personal_travel_point && ReadValue<u8>(global, 8) == 0 &&
+        GetCharacterHp(GetLocalPlayerCharacter()) > 0 && !BbscQuitInProgress() &&
+        !BbscDreamFinaleHolding() && BbscOwnOpeningDone()) {
+        bbsc_personal_travel_point = point;
+        bbsc_personal_travel_host = GetBbscRelayHost();
+        bbsc_personal_travel_started = SteadyNowMs();
+    }
+    return true;
+}
+
+void TickBbscPersonalTravel() {
+    if (GetSessionState() != 6 || GetBbscRelayHost() != bbsc_personal_travel_host ||
+        BbscQuitInProgress()) {
+        bbsc_personal_travel_active = false;
+        // A fresh request is bound to the current host below; old in-flight requests expire.
+        if (bbsc_personal_travel_host && GetBbscRelayHost() != bbsc_personal_travel_host)
+            bbsc_personal_travel_point = 0;
+        bbsc_personal_travel_host = GetBbscRelayHost();
+    }
+    if (!BbscPersonalTravelGuest()) { bbsc_personal_travel_point = 0; return; }
+    const u64 global = GetGlobalState();
+    if (ReadValue<u8>(global, 8) != 0) return;
+    if (bbsc_personal_travel_point) {
+        if (SteadyNowMs() - bbsc_personal_travel_started > 5000 ||
+            GetCharacterHp(GetLocalPlayerCharacter()) <= 0 || BbscDreamFinaleHolding()) {
+            bbsc_personal_travel_point = 0;
+            return;
+        }
+        const u64 rules = ReadValue<u64>(image_base + SummonSessionRulesPointerOffset, 0);
+        if (!HasMemoryAccess(rules + 0x84, 4, MemoryProt::CpuWrite) ||
+            !HasMemoryAccess(global + 0x1520, 1, MemoryProt::CpuWrite)) {
+            bbsc_personal_travel_point = 0;
+            return;
+        }
+        const s32 point = bbsc_personal_travel_point;
+        bbsc_personal_travel_point = 0;
+        bbsc_personal_travel_host = GetBbscRelayHost();
+        bbsc_personal_travel_active = true;
+        bbsc_personal_travel_started = SteadyNowMs();
+        ClearBbscBossContext("personal lamp travel");
+        // Same guest phase as RequestBbscSessionWarp, but native BONFIRE placement,
+        // never the stale forced summon coordinates or a new own-world snapshot.
+        ArmBbscReinsertV8();
+        WriteValue<s32>(rules, 0x84, 3);
+        WriteValue<u8>(global, 0x1520, 0);
+        reinterpret_cast<void PS4_SYSV_ABI (*)(s32)>(image_base + BbscQuitCloseMenusOffset)(3);
+        reinterpret_cast<void PS4_SYSV_ABI (*)(u64, s32)>(image_base + 0x0132E050)(0, point);
+        BBSC_TIMELINE("TRAVEL", "guest personal lamp point {}, host {} stays connected",
+                      point, bbsc_personal_travel_host);
+        return;
+    }
+    // A deliberate visit suppresses follow even if the host travels meanwhile.
+    // Reunite only after reaching the host's map, with a fresh host observation.
+    if (bbsc_personal_travel_active && SteadyNowMs() - bbsc_personal_travel_started > 5000) {
+        std::scoped_lock lock{bbsc_follow_mutex};
+        if (bbsc_follow_latest.received_ms > bbsc_personal_travel_started &&
+            bbsc_follow_latest.packed_map == GetCurrentPackedMap())
+            bbsc_personal_travel_active = false;
+    }
+}
